# Copy to .env (never commit .env). In GitHub Actions these are repository Secrets.
APIFY_TOKEN=
SERPAPI_KEY=
OPENAI_API_KEY=
SMTP_USER=
# Gmail App Password (Google Account > Security > App passwords), not your account password
SMTP_PASSWORD=
# comma-separated
BRIEF_RECIPIENTS=

# Optional
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# 1 = read fixtures/ (saved real responses), sample = synthetic test data, empty = call the APIs
USE_FIXTURES=
# ads | trends | llm
SIMULATE_FAIL=
